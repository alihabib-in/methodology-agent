FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# CPU-only torch first, so sentence-transformers reuses it (keeps the image small).
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY embedding_service/requirements.txt .

RUN pip install \
    --no-cache-dir \
    -r requirements.txt

COPY embedding_service ./embedding_service

RUN useradd \
    --create-home \
    --uid 10002 \
    appuser

RUN mkdir -p /home/appuser/.cache/huggingface \
    && chown -R appuser:appuser /home/appuser

ENV HF_HOME=/home/appuser/.cache/huggingface

USER appuser

EXPOSE 8001

CMD ["uvicorn", "embedding_service.main:app", "--host", "0.0.0.0", "--port", "8001"]
