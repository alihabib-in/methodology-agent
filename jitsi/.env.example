# =====================================================================
# Jitsi Meet — local development configuration
# Copy this file to `.env` and fill in real values (do NOT commit .env).
# Reference: https://github.com/jitsi/docker-jitsi-meet
# =====================================================================

# Directory where generated configuration is stored (relative to this dir)
CONFIG=./config

# Image repository/version (official ghcr.io/jitsi registry; `unstable` is the
# current rolling tag used by the docker-jitsi-meet quickstart. Pin a specific
# versioned tag for reproducible/production deployments.)
JITSI_IMAGE_REPO=ghcr.io/jitsi
JITSI_IMAGE_VERSION=unstable
RESTART_POLICY=unless-stopped

# System time zone
TZ=UTC

# Host ports — chosen to avoid the existing methodology stack
# (8000 api, 8001 embedding, 8080 llm, 5432 postgres, 6333/6334 qdrant)
HTTP_PORT=8880
HTTPS_PORT=8443
JVB_PORT=10000
JVB_COLIBRI_PORT=9080
JICOFO_REST_PORT=8888

# Public URL (a non-standard HTTPS port MUST appear in the URL)
PUBLIC_URL=https://localhost:8443

# XMPP domains (localhost needs no DNS/hosts entry)
XMPP_DOMAIN=localhost
XMPP_AUTH_DOMAIN=auth.localhost
XMPP_MUC_DOMAIN=muc.localhost
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.localhost
XMPP_GUEST_DOMAIN=guest.localhost
XMPP_RECORDER_DOMAIN=recorder.localhost
XMPP_SERVER=xmpp.meet.jitsi

# TLS — self-signed cert mounted at ./config/web/keys/cert.{key,crt}
ENABLE_SSL=1
DISABLE_HTTPS=0
ENABLE_HTTP_REDIRECT=1

# ---------------------------------------------------------------------
# Authentication
# For the first local prototype auth is OFF (the stack is bound to
# localhost). Enable JWT before any non-local exposure — the FastAPI
# backend is authoritative for session/authorization:
#   ENABLE_AUTH=1
#   AUTH_TYPE=jwt
# ---------------------------------------------------------------------
ENABLE_AUTH=0
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=scad_methodology
JWT_APP_SECRET=<generate-a-strong-secret>
JWT_ACCEPTED_ISSUERS=scad_methodology_backend
JWT_ACCEPTED_AUDIENCES=scad_methodology_meet

# Component secrets (REQUIRED — services will not start without these)
JICOFO_AUTH_PASSWORD=<generate-a-strong-password>
JICOFO_COMPONENT_SECRET=<generate-a-strong-password>
JVB_AUTH_PASSWORD=<generate-a-strong-password>

# JVB networking
# Advertise ONLY the host LAN IP. Do NOT add 127.0.0.1 here — remote clients
# would then receive a loopback candidate pointing at their own machine, which
# breaks media between participants on different machines.
JVB_ADVERTISE_IPS=10.50.128.97
# No external STUN on the corporate network; host candidates are enough.
JVB_DISABLE_STUN=1
JVB_TCP_HARVESTER_DISABLED=false
